{
  "expo": {
    "name": "BRITUME",
    "slug": "britume",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "britume",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BRITUME uses Face ID to keep your account secure."
        }
      ],
      "expo-video"
    ],
    "android": {
      "package": "com.britume.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.britume.app",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.britume.app"
        ]
      }
    }
  }
}
